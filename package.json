{
  "name": "tutor-ai",
  "version": "0.1.0",
  "description": "Generic, AI-First guided tours for React apps. Install it and Agent Skills are generated in your project.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "skills",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && node scripts/copy-css.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && npm run test:skills",
    "test:unit": "vitest run",
    "test:skills": "node --test test/install-skills.test.mjs",
    "skills:install": "node scripts/install-skills.mjs",
    "skills:uninstall": "node scripts/uninstall-skills.mjs",
    "prepublishOnly": "npm run build && npm test",
    "postinstall": "node scripts/install-skills.mjs"
  },
  "keywords": [
    "react",
    "tutorial",
    "onboarding",
    "coachmark",
    "guided-tour",
    "ai-first",
    "agent-skills"
  ],
  "license": "MIT",
  "author": "pauvalls",
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.0.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pauvalls/TutorAI.git"
  },
  "homepage": "https://github.com/pauvalls/TutorAI#readme",
  "bugs": {
    "url": "https://github.com/pauvalls/TutorAI/issues"
  }
}
